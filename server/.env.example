# ------------------------------------------------------------------
# GRAVITAS AI - backend configuration
# Copy this file to server/.env and fill in the values.
# server/.env is git-ignored. NEVER put these values in client/.env.
# ------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma separated, no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Supabase Dashboard -> Project Settings -> API / API Keys
SUPABASE_URL=
# The SECRET key: either the legacy "service_role" key or a new "sb_secret_..." key.
# It bypasses Row Level Security - keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional settings (defaults shown)
STORAGE_BUCKET=chat-attachments
MAX_UPLOAD_MB=5
SIGNED_URL_TTL_SECONDS=3600
# Set to true only when running behind a reverse proxy (for correct rate limiting)
TRUST_PROXY=false

# ------------------------------------------------------------------
# Optional: development seed accounts used by `npm run seed:demo`
# Choose your own passwords (min. 8 characters). Do not reuse real passwords.
# ------------------------------------------------------------------
# SEED_USER_EMAIL=student.user@example.com
# SEED_USER_PASSWORD=
# SEED_USER_NAME=Demo User
# SEED_OPERATOR_EMAIL=gravitas.operator@example.com
# SEED_OPERATOR_PASSWORD=
# SEED_OPERATOR_NAME=Gravitas Operator

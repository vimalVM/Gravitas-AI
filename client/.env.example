# ------------------------------------------------------------------
# GRAVITAS AI - frontend configuration
# Copy this file to client/.env and fill in the values.
# Everything prefixed with VITE_ is PUBLIC and ends up in the browser bundle.
# NEVER put the service_role / secret key here.
# ------------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
# The PUBLISHABLE key ("sb_publishable_...") or the legacy "anon" public key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Express API base URL. Use /api to go through the Vite dev proxy instead.
VITE_API_BASE_URL=http://localhost:5000/api
